#!/usr/bin/env python3
"""Check WCAG contrast of the resolved Omarchy palette.

Usage: contrast-check [colors.toml]
Exit 0 if every pair passes, 1 if any fails, 2 if the palette can't be resolved.
"""

import re
import subprocess
import sys
from pathlib import Path

DEFAULT_COLORS = Path(__file__).resolve().parent.parent / "colors.toml"

TEXT_ON_BACKGROUND = """
    foreground dark_foreground light_foreground bright_foreground accent
    red orange yellow green cyan blue magenta brown
    bright_red bright_yellow bright_green bright_cyan bright_blue bright_magenta
""".split()

PAIRS = [(key, "background", 4.5) for key in TEXT_ON_BACKGROUND] + [
    # Templates use muted both as dim text and as a fill under foreground text,
    # so 4.5 on one side forces the other below 4.5; both sides are held to 3.0.
    ("muted", "background", 3.0),
    ("muted", "lighter_background", 3.0),
    ("foreground", "muted", 3.0),
    ("foreground", "lighter_background", 4.5),
    ("foreground", "selection", 4.5),
    ("dark_foreground", "selection", 4.5),
    ("selection_foreground", "selection_background", 4.5),
    ("background", "accent", 4.5),
]

HEX_COLOR = re.compile(r"#[0-9a-fA-F]{6}")


def relative_luminance(hex_color):
    channels = (int(hex_color[i : i + 2], 16) / 255 for i in (1, 3, 5))
    r, g, b = (c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in channels)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast_ratio(a, b):
    lighter, darker = sorted((relative_luminance(a), relative_luminance(b)), reverse=True)
    return (lighter + 0.05) / (darker + 0.05)


def resolve_palette(colors_file):
    result = subprocess.run(
        ["omarchy-theme-color", "--file", str(colors_file), "--all"],
        capture_output=True,
        text=True,
        check=True,
    )
    return dict(line.split("\t", 1) for line in result.stdout.splitlines() if "\t" in line)


def check_pair(palette, foreground, background, minimum):
    label = f"{foreground:<22} {background:<22}"
    for key in (foreground, background):
        value = palette.get(key)
        if not value:
            return False, f"FAIL {label} {key} is missing"
        if not HEX_COLOR.fullmatch(value):
            return False, f"FAIL {label} {key} is not #rrggbb: {value}"
    fg, bg = palette[foreground], palette[background]
    ratio = contrast_ratio(fg, bg)
    passed = ratio >= minimum
    status = "PASS" if passed else "FAIL"
    return passed, f"{status} {label} {fg} {bg} {ratio:6.2f}  min {minimum}"


def main(argv):
    colors_file = Path(argv[1]) if len(argv) > 1 else DEFAULT_COLORS
    if not colors_file.is_file():
        print(f"contrast-check: no such file: {colors_file}", file=sys.stderr)
        return 2
    try:
        palette = resolve_palette(colors_file)
    except (OSError, subprocess.CalledProcessError) as error:
        print(f"contrast-check: omarchy-theme-color failed: {error}", file=sys.stderr)
        return 2

    all_passed = True
    for foreground, background, minimum in PAIRS:
        passed, line = check_pair(palette, foreground, background, minimum)
        print(line)
        all_passed &= passed
    return 0 if all_passed else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
