# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0a0a1a"

# Main text color
theme[main_fg]="#ffffff"

# Title color for boxes
theme[title]="#bba7be"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#81c4f3"

# Background color of selected item in processes box
theme[selected_bg]="#2e2e46"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#2e2e46"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#bba7be"

# Box outline and divider line color
theme[cpu_box]="#56b4e2"
theme[mem_box]="#56b4e2"
theme[net_box]="#56b4e2"
theme[proc_box]="#56b4e2"
theme[div_line]="#2e2e46"

# Gradient for all meters and graphs
theme[temp_start]="#81c4f3"
theme[temp_mid]="#8296d3"
theme[temp_end]="#56b4e2"


theme[cpu_start]="#81c4f3"
theme[cpu_mid]="#8296d3"
theme[cpu_end]="#56b4e2"


theme[free_start]="#8296d3"
theme[free_mid]="#E9984C"
theme[free_end]="#E9984C"


theme[cached_start]="#E9984C"
theme[cached_mid]="#E9984C"
theme[cached_end]="#E9984C"


theme[available_start]="#81c4f3"
theme[available_mid]="#81c4f3"
theme[available_end]="#81c4f3"


theme[used_start]="#56b4e2"
theme[used_mid]="#56b4e2"
theme[used_end]="#56b4e2"


theme[download_start]="#E9984C"
theme[download_mid]="#81c4f3"
theme[download_end]="#8296d3"


theme[upload_start]="#E9984C"
theme[upload_mid]="#81c4f3"
theme[upload_end]="#8296d3"